# Copy to .env.local for local dev. On production, set these in the host panel (do not use placeholders).
#
# Client-safe (exposed to the browser — never put secrets here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_APP_URL=https://whistleblower.ng

# Server-only (Route Handlers, Server Components — no NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_LIVE_SECRET_KEY=
RESEND_API_KEY=
